# Server-only. Do not prefix these with NEXT_PUBLIC_.
# Copy this file to .env.local and fill in values. Leave a key empty to skip that integration.

# External AI (text + vision). Empty AI_API_KEY uses the built-in mock parser.
AI_API_KEY=
AI_API_BASE_URL=
AI_TEXT_MODEL=
AI_VISION_MODEL=

# Supabase. The service role key must stay on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret: WhatsApp X-Hub-Signature-256 and fallback verify tokens.
WEBHOOK_SECRET=

# WhatsApp Cloud API GET verification (hub.verify_token). Falls back to WEBHOOK_SECRET.
WHATSAPP_VERIFY_TOKEN=

# WeChat / WeCom official-account URL token. Falls back to WEBHOOK_SECRET.
WECHAT_TOKEN=
# Optional 43-char EncodingAESKey for WeCom / encrypted official-account messages.
WECHAT_ENCODING_AES_KEY=
